# Go
api/server

# Python
ai/__pycache__/
*.pyc

# React Native / Node
# node_modules is very large. Anyone can rebuild it with "npm install".
mobile/node_modules/
mobile/.expo/
# Expo also drops a cache folder at the repo root if started from here.
.expo/

# Environment files. These may hold passwords. Never save them in Git.
.env

# Local reference books and generated retrieval indexes.
ai/books/*.pdf
ai/data/

# Notebook working files
ai/notebooks/.ipynb_checkpoints/
ai/notebooks/data/*.csv

# Python virtual environment
ai/notebooks/venv/

# NOTE: ai/artifacts/ is deliberately NOT ignored.
# Docker copies those files into the image, so Phase 6 needs them in Git.
